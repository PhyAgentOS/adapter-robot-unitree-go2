<mujoco>
    <compiler angle="radian" />
    <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" />
    <visual>
        <headlight ambient="0.8 0.8 0.8" diffuse="0.2 0.2 0.2" specular="0 0 0" active="1" />
        <map force="0.1" zfar="40" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global offwidth="2560" offheight="1440" elevation="-20" azimuth="135" />
    </visual>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="flat" mark="edge" rgb1="0.1 0.1 0.1" rgb2="0.3 0.5 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
        <model name="go2" file="Go2.xml" />
    </asset>
    <worldbody>
        <light castshadow="false" directional="true" diffuse=".3 .3 .3" specular="0.3 0.3 0.3" pos="-1 -1 1" dir="1 1 -1" />
        <light directional="true" diffuse=".3 .3 .3" specular="0.3 0.3 0.3" pos="1 -1 1" dir="-1 1 -1" />
        <light castshadow="false" directional="true" diffuse=".3 .3 .3" specular="0.3 0.3 0.3" pos="0 1 1" dir="0 -1 -1" />
        <geom name="floor" size="50 50 0.05" pos="0 0 0" type="plane" material="groundplane" />
        <!-- 前方 8 cm 级差楼梯，供 stairs_blind 策略验证。 -->
        <geom name="stair_1" type="box" size="0.125 2.0 0.04" pos="1.125 0 0.04" material="groundplane"/>
        <geom name="stair_2" type="box" size="0.125 2.0 0.08" pos="1.375 0 0.08" material="groundplane"/>
        <geom name="stair_3" type="box" size="0.125 2.0 0.12" pos="1.625 0 0.12" material="groundplane"/>
        <geom name="stair_4" type="box" size="0.125 2.0 0.16" pos="1.875 0 0.16" material="groundplane"/>
        <geom name="stair_5" type="box" size="0.125 2.0 0.20" pos="2.125 0 0.20" material="groundplane"/>
        <geom name="origin_marker" type="sphere" pos="0 0 0" size="0.01" rgba="1 0 0 1" contype="0" conaffinity="0" />
        <geom name="x_axis" type="cylinder" fromto="0 0 0 0.1 0 0" size="0.002" rgba="1 0 0 1" contype="0" conaffinity="0" />
        <geom name="y_axis" type="cylinder" fromto="0 0 0 0 0.1 0" size="0.002" rgba="0 1 0 1" contype="0" conaffinity="0" />
        <geom name="z_axis" type="cylinder" fromto="0 0 0 0 0 0.1" size="0.002" rgba="0 0 1 1" contype="0" conaffinity="0" />
        <body name="item_1" pos="0.0 0.0 0.0" quat="1.000000 0.000000 0.000000 -0.000000">
            <joint type="free"/>
            <attach model="go2" body="base" prefix="item_1/" />
        </body>
        <!-- 第三人称相机：跟踪 Go2 主体，使 image_viewer 能看到完整机器狗。 -->
        <camera name="overview" mode="targetbody" target="item_1/base"
                pos="1.8 -1.8 1.1" fovy="50"/>
    </worldbody>
    <keyframe>
        <key name="home"
             qpos="0 0 0.32 1 0 0 0 -0.1 0.9 -1.8 0.1 0.9 -1.8 -0.1 0.9 -1.8 0.1 0.9 -1.8"/>
    </keyframe>
</mujoco>